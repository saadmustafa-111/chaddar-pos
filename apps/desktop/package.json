{
  "name": "desktop",
  "version": "1.0.12",
  "description": "SteelCoil POS Desktop Application",
  "main": "dist/main/index.js",
  "author": "SteelCoil",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-log": "^5.2.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "com.steelchaddar.pos",
    "productName": "SteelChaddar POS",
    "copyright": "Copyright © 2026 SteelChaddar",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../api/deploy",
        "to": "api"
      },
      {
        "from": "../web/.next/standalone",
        "to": "web",
        "filter": ["**/*"]
      },
      {
        "from": "../web/public",
        "to": "web/public",
        "filter": ["**/*"]
      },
      {
        "from": "../web/package.json",
        "to": "web/package.json"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "resources/api/**/node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SteelChaddar POS"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "npmRebuild": true,
    "nodeGypRebuild": false,
    "afterPack": "./scripts/afterPack.js"
  }
}
